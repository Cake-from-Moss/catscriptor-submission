<?xml version="1.0" encoding="utf-8"?>
<!--
   Audio and transcripts must never leave the device (AGENTS.md, hard constraint 1).
   On Android 12+ allowBackup="false" stops cloud backup but not device-to-device
   transfer, so both channels exclude all app data here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
